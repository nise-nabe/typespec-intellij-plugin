{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TypeSpec Project Configuration",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["project"]
    },
    "entrypoint": {
      "type": "string"
    },
    "output-dir": {
      "type": "string"
    },
    "emit": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "object"
    },
    "features": {
      "type": "object"
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
