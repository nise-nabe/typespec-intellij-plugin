{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TypeSpec Project Configuration",
  "type": "object",
  "definitions": {
    "parameterValue": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/parameterValue"
      }
    }
  },
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["project"]
    },
    "entrypoint": {
      "type": "string"
    },
    "extends": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/parameterValue"
      }
    },
    "environment-variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/parameterValue"
      }
    },
    "output-dir": {
      "type": "string"
    },
    "emit": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "object"
    },
    "trace": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "warn-as-error": {
      "type": "boolean"
    },
    "dry-run": {
      "type": "boolean"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linter": {
      "type": "object",
      "properties": {
        "extends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enable": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "boolean" },
              { "type": "object" }
            ]
          }
        },
        "disable": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["entrypoint"] },
          { "required": ["features"] }
        ]
      },
      "then": {
        "properties": {
          "kind": { "const": "project" }
        },
        "required": ["kind"]
      }
    }
  ]
}
